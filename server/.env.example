# Copy to .env and change these before deploying anywhere real.
# (.env is git-ignored, so your real secrets are never committed.)

PORT=4000

# ── Database (PostgreSQL) ────────────────────────────────────────────
# Connection string for your Postgres database. On a managed host (Render,
# Railway, Supabase, etc.) copy the "Internal"/"Connection" URL they give you.
# Local example: postgres://sowoccul:password@localhost:5432/sowoccul
DATABASE_URL=postgres://user:password@localhost:5432/sowoccul

# TLS to the database. Managed Postgres requires SSL and it is ON by default
# for any non-localhost host. Set to "false" ONLY for a local dev database.
# DATABASE_SSL=false

# Max connections in the pool (keep small on hobby/free tiers).
PG_POOL_MAX=10

# Used to sign session tokens. Generate a long random string in production,
# e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# How long a login session stays valid.
JWT_EXPIRES_IN=8h

# Where the frontend runs (for CORS).
CLIENT_ORIGIN=http://localhost:5173

# Logging verbosity: debug | info | warn | error | silent (default info).
LOG_LEVEL=info

# ── First administrator ──────────────────────────────────────────────
# Used once by `npm run seed` to create your first admin login on a fresh,
# empty database. Choose a STRONG password (min 8 chars). After first login
# you can change it and create your staff and members from the admin console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@yourdomain.cm
ADMIN_BRANCH=Limbe
